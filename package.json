{
  "name": "orrery",
  "version": "1.158.5",
  "private": true,
  "description": "A self-hosted catalog and canvas for everything you own and run: push it in, see how it connects, know if it's healthy.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server/main.ts & vite",
    "dev:server": "node --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "icons": "node scripts/brand-icons.mjs",
    "openapi": "node scripts/openapi.ts"
  },
  "dependencies": {
    "@hono/mcp": "0.3.2",
    "@hono/node-server": "2.1.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@tanstack/react-virtual": "3.14.23",
    "elkjs": "0.12.0",
    "hono": "4.13.19",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "undici": "8.12.2",
    "web-vitals": "6.2.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@iconify-json/devicon": "1.2.68",
    "@iconify-json/logos": "1.2.15",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/vscode-icons": "1.2.83",
    "@lezer/highlight": "1.2.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "simple-icons": "16.33.0",
    "simple-icons-11": "npm:simple-icons@11.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.0.3"
  }
}
